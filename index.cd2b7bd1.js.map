document.addEventListener("click", function(e) {
    // write code here
    var spider = document.querySelector(".spider");
    var wall = document.querySelector(".wall");
    var wallEl = wall.getBoundingClientRect();
    var spiderEl = spider.getBoundingClientRect();
    var x = e.clientX - wallEl.left - wall.clientLeft - spiderEl.width / 2;
    var y = e.clientY - wallEl.top - wall.clientTop - spiderEl.height / 2;
    x = Math.max(0, Math.min(x, wall.clientWidth - spider.clientWidth));
    y = Math.max(0, Math.min(y, wall.clientHeight - spider.clientHeight));
    var leftWall = Math.round(wallEl.left);
    var topWall = Math.round(wallEl.top);
    var rightWall = leftWall + wallEl.width;
    var bottomWall = topWall + wallEl.height;
    var isInside = e.clientX > leftWall && e.clientY < rightWall && e.clientY > topWall && e.clientY < bottomWall;
    if (isInside) {
        spider.style.left = "".concat(x, "px");
        spider.style.top = "".concat(y, "px");
    }
});

